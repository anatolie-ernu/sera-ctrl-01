{
  "dashboard": {
    "title": "Sera — Fleet Overview",
    "timezone": "Europe/Chisinau",
    "refresh": "30s",
    "panels": [
      { "id": 1, "title": "Dispozitive online", "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
        "targets": [{ "expr": "sera_devices_online" }] },
      { "id": 2, "title": "Total flota", "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
        "targets": [{ "expr": "sera_devices_total" }] },
      { "id": 3, "title": "Alerte critice (rata/h)", "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
        "targets": [{ "expr": "rate(sera_alerts_total{severity=\"critical\"}[1h])*3600" }] },
      { "id": 4, "title": "Mesaje MQTT/s", "type": "stat",
        "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
        "targets": [{ "expr": "rate(sera_mqtt_messages_total[5m])" }] },
      { "id": 5, "title": "Temperatura per dispozitiv", "type": "timeseries",
        "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
        "targets": [{ "expr": "sera_sensor_temp", "legendFormat": "{{device}}" }] },
      { "id": 6, "title": "Stari OTA", "type": "piechart",
        "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
        "targets": [{ "expr": "sera_ota_state", "legendFormat": "{{state}}" }] }
    ]
  },
  "overwrite": true
}

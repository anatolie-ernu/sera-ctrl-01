{
  "expo": {
    "name": "Sera Inteligenta",
    "slug": "sera-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sera",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "md.sera.app",
      "permissions": ["CAMERA", "INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "ios": {
      "bundleIdentifier": "md.sera.app",
      "infoPlist": { "NSCameraUsageDescription": "Pentru scanarea codului QR de pe sera." }
    },
    "plugins": ["expo-camera", "expo-secure-store", "expo-notifications"]
  }
}

# Copiaza in .env si completeaza:  cp .env.example .env && nano .env

# TimescaleDB (PostgreSQL)
POSTGRES_PASSWORD=schimba_parola_puternica_postgres
POSTGRES_DB=sera_db
POSTGRES_USER=sera_user

# Redis
REDIS_PASSWORD=schimba_parola_redis

# MQTT
MQTT_USER=sera_backend
MQTT_PASS=schimba_parola_mqtt

# JWT - genereaza cu: openssl rand -hex 64
JWT_SECRET=genereaza_cu_openssl_rand_hex_64_aici
JWT_REFRESH_SECRET=genereaza_alt_secret_diferit_hex_64

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa@gmail.com
SMTP_PASS=parola_aplicatie_google
SMTP_FROM="Sera Inteligenta <adresa@gmail.com>"

# SMS (twilio|smsapi|vonage)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_API_KEY=cheia_ta_api_twilio
SMS_FROM=+40700000000

# Domeniu pentru SSL
DOMAIN=sera.domeniultau.ro
CERTBOT_EMAIL=email@domeniultau.ro

# App
NODE_ENV=production
LOG_LEVEL=info
